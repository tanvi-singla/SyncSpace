# =============================================================================
# SyncSpace – Environment Variables Reference
# Copy this file to .env for local development. Never commit .env.
# All variables marked [RENDER REQUIRED] must be set in the Render dashboard
# under Environment → Environment Variables before deploying.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# [RENDER REQUIRED] Set this to your Neon connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# JWT secret – must be a long, random string in production.
# [RENDER REQUIRED] Generate with: openssl rand -hex 64
# ---------------------------------------------------------------------------
JWT_SECRET="syncspace-dev-secret-change-in-prod"

# ---------------------------------------------------------------------------
# Node environment
# [RENDER REQUIRED] Set to "production" on Render.
# ---------------------------------------------------------------------------
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Server port – Render injects PORT automatically; do NOT set this on Render.
# Used only for local development fallback (default: 5000).
# ---------------------------------------------------------------------------
PORT="5000"

# ---------------------------------------------------------------------------
# Frontend / CORS origin
# [RENDER REQUIRED] Set to the public URL of your deployed frontend.
# Also used to construct password reset links.
# Example: https://syncspace.onrender.com
# ---------------------------------------------------------------------------
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Password reset email (Resend)
# [RENDER REQUIRED] Set a real Resend API key and verified sender address.
# Never use a VITE_ prefix for provider credentials; these are server-only.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
# For Resend development testing, onboarding@resend.dev can send only to the
# account's permitted recipient. Use a verified sender domain in production.
PASSWORD_RESET_FROM_EMAIL="SyncSpace <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Vite frontend – WebSocket URL
# For LOCAL development, point to the Express server (same port as API).
# In production Render builds, set VITE_WS_URL to your Render backend URL:
#   e.g.  wss://syncspace-api.onrender.com
# Vite only bakes this in at build time; it is NOT a runtime server variable.
# [RENDER REQUIRED for frontend build] Set as a Render environment variable
# so `npm run build` picks it up during the build step.
# ---------------------------------------------------------------------------
VITE_WS_URL="ws://localhost:5000"

# ---------------------------------------------------------------------------
# Local Docker PostgreSQL (optional – only if you run Postgres locally with
# docker-compose instead of Neon). Not used by the application directly.
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncspace

# ---------------------------------------------------------------------------
# Yjs auth bypass – ONLY for automated tests. NEVER set on Render.
# ---------------------------------------------------------------------------
# YJS_AUTH_REQUIRED=false

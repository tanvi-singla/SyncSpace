# =============================================================================
# SyncSpace – Environment Variables Reference
# Copy this file to .env for local development. Never commit .env.
# All variables marked [RENDER REQUIRED] must be set in the Render dashboard
# under Environment → Environment Variables before deploying.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# [RENDER REQUIRED] Set this to your Neon connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# JWT & Session secret – must be a long, random string in production.
# [RENDER REQUIRED] Generate with: openssl rand -hex 64
# Minimum 32 characters in production.
# ---------------------------------------------------------------------------
JWT_SECRET="syncspace-dev-secret-change-in-prod"

# ---------------------------------------------------------------------------
# OAuth state signature secret (HMAC-SHA256 for state cookie validation)
# [RENDER REQUIRED] Generate with: openssl rand -hex 32
# If omitted, falls back to JWT_SECRET.
# ---------------------------------------------------------------------------
OAUTH_STATE_SECRET="syncspace-oauth-state-secret-min-32-chars-long"

# ---------------------------------------------------------------------------
# Node environment
# [RENDER REQUIRED] Set to "production" on Render.
# ---------------------------------------------------------------------------
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Server port & host – Render injects PORT automatically; do NOT set PORT on Render.
# Used only for local development fallback (default: 5000).
# ---------------------------------------------------------------------------
PORT="5000"
HOST="0.0.0.0"

# ---------------------------------------------------------------------------
# Public URLs
# [RENDER REQUIRED on backend web service]
# Backend / API public URL:
#   Local: http://localhost:5000
#   Production: https://syncspace-api.onrender.com
# Frontend public URL:
#   Local: http://localhost:5173
#   Production: https://syncspace.onrender.com
# ---------------------------------------------------------------------------
API_URL="http://localhost:5000"
BACKEND_URL="http://localhost:5000"
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
OAUTH_FRONTEND_URL="http://localhost:5173"
OAUTH_CALLBACK_BASE_URL="http://localhost:5000"

# ---------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# [RENDER REQUIRED on backend web service if Google login is enabled]
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services → Credentials → Create Credentials → OAuth client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs:
#      Local dev:   http://localhost:5000/api/auth/google/callback
#      Production:  https://syncspace-api.onrender.com/api/auth/google/callback
# 5. Scopes used: openid, email, profile
# ---------------------------------------------------------------------------
OAUTH_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
OAUTH_GOOGLE_CLIENT_SECRET="your-google-client-secret"
OAUTH_GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# ---------------------------------------------------------------------------
# GitHub OAuth App Credentials
# [RENDER REQUIRED on backend web service if GitHub login is enabled]
# 1. Go to GitHub Settings → Developer settings → OAuth Apps → New OAuth App
# 2. Homepage URL:
#      Local dev:   http://localhost:5173
#      Production:  https://syncspace.onrender.com
# 3. Authorization callback URL:
#      Local dev:   http://localhost:5000/api/auth/github/callback
#      Production:  https://syncspace-api.onrender.com/api/auth/github/callback
# 4. Scopes used: read:user, user:email
# ---------------------------------------------------------------------------
OAUTH_GITHUB_CLIENT_ID="your-github-client-id"
OAUTH_GITHUB_CLIENT_SECRET="your-github-client-secret"
OAUTH_GITHUB_CALLBACK_URL="http://localhost:5000/api/auth/github/callback"

# ---------------------------------------------------------------------------
# Password reset email (Resend)
# [RENDER REQUIRED on backend] Set a real Resend API key and verified sender.
# Never use a VITE_ prefix for provider credentials; these are server-only.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
# For Resend development testing, onboarding@resend.dev can send only to the
# account's permitted recipient. Use a verified sender domain in production.
PASSWORD_RESET_FROM_EMAIL="SyncSpace <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Vite frontend build-time environment variables
# These variables are baked into frontend bundles at `npm run build` time.
# NEVER place secrets here.
# ---------------------------------------------------------------------------
# WebSocket URL for real-time CRDT collaboration:
#   Local:      ws://localhost:5000
#   Production: wss://syncspace-api.onrender.com
VITE_WS_URL="ws://localhost:5000"

# Backend API URL (optional for local dev where Vite proxies /api -> http://localhost:5000;
# REQUIRED for production frontend builds when API is hosted on a separate subdomain/origin):
#   Local:      (can be left blank or set to http://localhost:5000)
#   Production: https://syncspace-api.onrender.com
VITE_API_URL="http://localhost:5000"

# ---------------------------------------------------------------------------
# Local Docker PostgreSQL (optional – only if you run Postgres locally with
# docker-compose instead of Neon). Not used by the application directly.
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncspace

# ---------------------------------------------------------------------------
# Yjs auth bypass – ONLY for automated tests. NEVER set on Render.
# ---------------------------------------------------------------------------
# YJS_AUTH_REQUIRED=false
